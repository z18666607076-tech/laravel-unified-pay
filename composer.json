{
    "name": "freeman/laravel-unified-pay",
    "description": "One Laravel-native interface for WeChat Pay, Alipay, and Stripe, with signed webhooks and idempotent event handling.",
    "keywords": [
        "laravel",
        "payments",
        "wechat-pay",
        "alipay",
        "stripe",
        "webhook"
    ],
    "homepage": "https://github.com/z18666607076-tech/laravel-unified-pay",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "laravel-unified-pay contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "illuminate/cache": "^11.44 || ^12.4 || ^13.0",
        "illuminate/contracts": "^11.44 || ^12.4 || ^13.0",
        "illuminate/database": "^11.44 || ^12.4 || ^13.0",
        "illuminate/events": "^11.44 || ^12.4 || ^13.0",
        "illuminate/http": "^11.44 || ^12.4 || ^13.0",
        "illuminate/routing": "^11.44 || ^12.4 || ^13.0",
        "illuminate/support": "^11.44 || ^12.4 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^9.16 || ^10.9 || ^11.0",
        "pestphp/pest": "^3.7 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.1 || ^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Freeman\\UnifiedPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Freeman\\UnifiedPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Freeman\\UnifiedPay\\UnifiedPayServiceProvider"
            ],
            "aliases": {
                "Pay": "Freeman\\UnifiedPay\\Facades\\Pay"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
